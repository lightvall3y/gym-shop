# Copy to .env and edit. docker compose reads .env automatically; every value has a default.

# --- Chatbot (Claude). Without a key the chat widget answers "chatbot not configured".
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-5-5
# Optional: use the fake LLM from scripts/mock-anthropic.mjs (ANTHROPIC_API_KEY can then be any value)
ANTHROPIC_BASE_URL=

# --- Secrets (change for anything other than local use)
JWT_SECRET=dev-only-secret-change-me-at-least-32-characters-long
ADMIN_API_KEY=dev-admin-key

# --- Deliberate bugs that start switched on (comma-separated), see README.
# Options: cart_total_wrong, checkout_500, stock_ignored, login_wrong_error, chat_invents_policy, chat_leaks_other_orders
BUGS=

# --- Ports on the host
WEB_PORT=3001
API_PORT=5080
DB_PORT=5433

# --- Set to true when the site is served over HTTPS (marks the auth cookie Secure)
COOKIE_SECURE=false
